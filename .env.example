# Vorlage für die Umgebungsvariablen.
# Lokal: Datei kopieren nach `.env` und echte Werte eintragen (.env ist in .gitignore).
# Vercel: Die Supabase-Werte setzt die Supabase-Integration von Vercel automatisch
# (Storage → Supabase → mit dem Projekt verbinden). Die Kinde-Werte unter
# Project → Settings → Environment Variables eintragen.
# Niemals echte Werte in diese Datei schreiben!

# ─── Datenbank (Supabase Postgres, für Prisma) ───────────────────────────────
# Die Namen entsprechen denen der Vercel-Supabase-Integration.
# Supabase → Projekt → "Connect" → ORMs → Prisma
# POSTGRES_PRISMA_URL: Transaction Pooler (Port 6543). Für Serverless (Vercel) nötig,
# sonst gehen bei vielen Requests die Datenbank-Verbindungen aus.
POSTGRES_PRISMA_URL="postgresql://postgres.<PROJECT-REF>:<DB-PASSWORT>@aws-0-<REGION>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# POSTGRES_URL_NON_POOLING: Session Pooler (Port 5432). Nur für `prisma db push`.
POSTGRES_URL_NON_POOLING="postgresql://postgres.<PROJECT-REF>:<DB-PASSWORT>@aws-0-<REGION>.pooler.supabase.com:5432/postgres"

# ─── Supabase Storage (Bild-Upload in den Bucket "images") ───────────────────
# Supabase → Project Settings → API Keys
# SUPABASE_SERVICE_ROLE_KEY: geheimer Server-Key ("service_role" oder der neue
# "secret key", sb_secret_...). Wird nur auf dem Server gelesen, kein NEXT_PUBLIC_.
SUPABASE_URL="https://<PROJECT-REF>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""

# ─── Kinde (Login) ───────────────────────────────────────────────────────────
# Kinde → Settings → Applications → <App> → Quick start / Details
KINDE_CLIENT_ID=""
KINDE_CLIENT_SECRET=""
KINDE_ISSUER_URL="https://<DEINE-DOMAIN>.kinde.com"

# Lokal: http://localhost:3000
# Vercel: https://<projektname>.vercel.app (ohne Slash am Ende)
KINDE_SITE_URL="http://localhost:3000"
KINDE_POST_LOGOUT_REDIRECT_URL="http://localhost:3000"
# Nach dem Login legt diese Route den User in der Datenbank an
KINDE_POST_LOGIN_REDIRECT_URL="http://localhost:3000/api/auth/creation"
